	measure DREAlt_3M_Media = CALCULATE( [Valor_DRE_Alt], 'Análise DRE'[Análise DRE] = "Média 3M" )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: e7d80681-b3ad-45f8-a02b-e0d2c5f0f41d

