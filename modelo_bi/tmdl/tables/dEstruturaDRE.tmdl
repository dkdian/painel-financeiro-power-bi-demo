	measure DREAlt_Mes_Valor = CALCULATE( [Valor_DRE_Alt], 'Análise DRE'[Análise DRE] = "Total" )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: efe82418-bc60-4159-a1c1-43d6f21fdcfc

