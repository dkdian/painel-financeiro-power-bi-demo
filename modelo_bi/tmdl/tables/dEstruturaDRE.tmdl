		formatString: 0.0%;0.0%;0.0%
		displayFolder: Relatorio
		lineageTag: 2beb3120-bd69-4b70-8500-0863a0555a22

	/// T04 coluna Ano. Valor_DRE do ano ate o mes mais recente com lancamento (nunca DATESYTD puro: o calendario vai ate dez/2026 sem dados, regra 5 do plano).
	measure DRE_Ano_Valor =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			RETURN
			    CALCULATE(
			        [Valor_DRE],
			        DATESBETWEEN( dCalendario[Date], DATE( YEAR( _RefData ), 1, 1 ), _RefData )
			    )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 2b0e7495-8d41-4265-8a84-d6e7a6add26d

	/// T04 coluna Media 12 meses.
	measure DRE_Ano_Media12M = CALCULATE( [Valor_DRE], 'Análise DRE'[Análise DRE] = "Média 12M" )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 06dd201d-29ac-4a75-9b50-62b9c261c17a

	/// T04 coluna % 12 meses.
	measure DRE_Ano_Pct12M = CALCULATE( [Valor_DRE], 'Análise DRE'[Análise DRE] = "% 12M" )
		formatString: 0.0%;0.0%;0.0%
		displayFolder: Relatorio
		lineageTag: 8d77d4da-cb77-4e45-8761-6f70bead6166

	/// Valor de cada coluna da matriz DRE (colunas de dColunasDRE): meses reais e Total, %, médias. Usa as medidas DRE_* existentes; respeita o filtro de Período.
	measure DRE_Valor_Coluna =
			VAR _col = SELECTEDVALUE ( dColunasDRE[Coluna] )
			VAR _tipo = SELECTEDVALUE ( dColunasDRE[Tipo] )
			VAR _num = SELECTEDVALUE ( dColunasDRE[AnoMes] )
			RETURN
			    IF (
			        ISBLANK ( _col ),
			        BLANK (),
			        IF (
			            _tipo = "Mês",
			            CALCULATE ( [Valor_DRE], dCalendario[Ano_Mês_Num] = _num ),
			            SWITCH (
			                _col,
			                "Total", [DRE_Mes_Valor],
			                "%", [DRE_Mes_Pct],
			                "Média 3M", [DRE_3M_Media],
			                "% 3M", [DRE_3M_Pct],
			                "Média 6M", [DRE_6M_Media],
			                "% 6M", [DRE_6M_Pct],
			                "Média 12M", [DRE_Ano_Media12M],
			                "% 12M", [DRE_Ano_Pct12M]
			            )
			        )
			    )
		lineageTag: 3089161d-9826-4018-a01a-3ec4b4377c31

		formatStringDefinition =
				IF (
				    SELECTEDVALUE ( dColunasDRE[Coluna] ) IN { "%", "% 3M", "% 6M", "% 12M" },
				    "0.00%;-0.00%;0.00%",
				    """R$""\ #,0.00;-""R$""\ #,0.00;""R$""\ #,0.00"
				)

	/// Valor de cada coluna da matriz DRE Alternativa (colunas de dColunasDRE): meses reais e Total, %, médias. Mesma lógica de DRE_Valor_Coluna, sobre Valor_DRE_Alt; respeita o filtro de Período.
	measure DRE_Valor_Coluna_Alt =
			VAR _col = SELECTEDVALUE ( dColunasDRE[Coluna] )
			VAR _tipo = SELECTEDVALUE ( dColunasDRE[Tipo] )
			VAR _num = SELECTEDVALUE ( dColunasDRE[AnoMes] )
			RETURN
			    IF (
			        ISBLANK ( _col ),
			        BLANK (),
			        IF (
			            _tipo = "Mês",
			            CALCULATE ( [Valor_DRE_Alt], dCalendario[Ano_Mês_Num] = _num ),
			            CALCULATE ( [Valor_DRE_Alt], 'Análise DRE'[Análise DRE] = _col )
			        )
			    )
		lineageTag: 2e63e6c4-ae9f-465a-8eb7-acb97f9173aa

		formatStringDefinition =
				IF (
				    SELECTEDVALUE ( dColunasDRE[Coluna] ) IN { "%", "% 3M", "% 6M", "% 12M" },
				    "0.00%;-0.00%;0.00%",
				    """R$""\ #,0.00;-""R$""\ #,0.00;""R$""\ #,0.00"
				)

