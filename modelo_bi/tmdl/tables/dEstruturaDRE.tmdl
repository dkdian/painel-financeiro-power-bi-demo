table dEstruturaDRE
	lineageTag: 5c271f5c-251f-4631-b61d-0773273f69ad

	measure Valor_DRE_Alt =
			
			VAR LinhaSelecionada = SELECTEDVALUE(dEstruturaDRE[ID])
			VAR VisaoAtual = SELECTEDVALUE(dEstruturaDRE[Visão])
			
			VAR _Receita = [Receita_Operacional] + [Receita_Financeira]
			VAR _DespVar = [Tributo]
			VAR _CMV = [Custo_Operacional]
			VAR _DespFixa = [Despesa_Fixa] + [Despesa_Variavel] + [Despesa_Pessoal] + [Marketing_Comercial] + [Despesa_Financeira]
			
			RETURN
			    IF(
			        VisaoAtual = "Alt",
			        SWITCH(
			            LinhaSelecionada,
			            1, _Receita,
			            2, _DespVar,
			            3, _CMV,
			            4, _DespFixa,
			            5, _Receita + _DespVar + _CMV + _DespFixa,
			            BLANK()
			        ),
			        BLANK()
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 00769886-6486-4758-89c4-ee1f5a609372

	measure Valor_DRE =
			
			-- Seleciona a linha pelo ID numérico (mais barato que comparar texto em cada célula).
			-- IDs da visão Standard: 1 Receita Op … 13 Resultado (ver dEstruturaDRE).
			VAR _Id = SELECTEDVALUE( dEstruturaDRE[ID] )
			RETURN
			    IF( _Id <> BLANK() && SELECTEDVALUE( dEstruturaDRE[Visão] ) = "Standard",
			        VAR _Det = ISINSCOPE( ControleFinanceiro[Detalhamento/Categoria II] )
			        RETURN SWITCH( _Id,
			            1, [Receita_Operacional],
			            2, [Tributo],
			            3, IF( _Det, BLANK(), [Receita_Liquida] ),
			            4, [Custo_Operacional],
			            5, IF( _Det, BLANK(), [Lucro_Bruto] ),
			            6, [Despesa_Fixa],
			            7, [Despesa_Variavel],
			            8, [Despesa_Pessoal],
			            9, [Marketing_Comercial],
			            10, IF( _Det, BLANK(), [Lucro_Operacional] ),
			            11, [Receita_Financeira],
			            12, [Despesa_Financeira],
			            13, IF( _Det, BLANK(), [Resultado_Exercicio] ) ) )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 3ab65620-fb18-4140-9621-60759df8a489

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Valor_DRE_CC =
			
			VAR LinhaSelecionada = SELECTEDVALUE(dEstruturaDRE[Linha])
			VAR VisaoAtual = SELECTEDVALUE(dEstruturaDRE[Visão])
			VAR NivelDetalhe = ISINSCOPE(ControleFinanceiro[Detalhamento/Categoria II])
			
			-- Rateio do ADM igual ao da aba Gráficos do Controle Financeiro (linhas 123 e 128):
			-- mês a mês, pela participação da cozinha na receita do mês.
			-- Tributo do ADM vai para a linha (-) Tributo; o resto do gasto do ADM
			-- (inclusive Investimento, sem Receita Financeira) vai para Despesa Fixa Administrativa.
			VAR _Meses =
			    ADDCOLUMNS(
			        VALUES( dCalendario[Ano_Mês_Num] ),
			        "@Part", DIVIDE(
			            CALCULATE( [Receita_Operacional], REMOVEFILTERS( ControleFinanceiro[Detalhamento/Categoria II] ) ),
			            CALCULATE( [Receita_Operacional], ALL( ControleFinanceiro[C. C.] ), REMOVEFILTERS( ControleFinanceiro[Detalhamento/Categoria II] ) )
			        ),
			        "@TributoADM", CALCULATE( [Tributo], ALL( ControleFinanceiro[C. C.] ), ControleFinanceiro[C. C.] = "ADM" ),
			        "@GastoADM", CALCULATE(
			            [Custo_Operacional] + [Despesa_Fixa] + [Despesa_Variavel] + [Despesa_Pessoal] + [Marketing_Comercial] + [Despesa_Financeira]
			                - CALCULATE( [Valor_Total], ControleFinanceiro[Categoria] = "Investimento" ),
			            ALL( ControleFinanceiro[C. C.] ), ControleFinanceiro[C. C.] = "ADM"
			        )
			    )
			VAR _TributoRateado = SUMX( _Meses, [@Part] * [@TributoADM] )
			VAR _DespFixaAdmRateada = SUMX( _Meses, [@Part] * [@GastoADM] )
			VAR _Tributo = [Tributo] + _TributoRateado
			VAR _ReceitaLiquida = [Receita_Operacional] + _Tributo
			VAR _LucroBruto = _ReceitaLiquida + [Custo_Operacional]
			VAR _LucroOperacional = _LucroBruto + [Despesa_Fixa] + _DespFixaAdmRateada + [Despesa_Variavel] + [Despesa_Pessoal] + [Marketing_Comercial]
			VAR _Resultado = _LucroOperacional + [Receita_Financeira] + [Despesa_Financeira]
			
			RETURN
			    IF(
			        VisaoAtual = "CC",
			        SWITCH(
			            TRUE(),
			            LinhaSelecionada = "(+) Receita Operacional", [Receita_Operacional],
			            LinhaSelecionada = "(-) Tributo", _Tributo,
			            LinhaSelecionada = "(=) Receita Líquida", IF(NivelDetalhe, BLANK(), _ReceitaLiquida),
			            LinhaSelecionada = "(-) Custo Operacional", [Custo_Operacional],
			            LinhaSelecionada = "(=) Lucro Bruto", IF(NivelDetalhe, BLANK(), _LucroBruto),
			            LinhaSelecionada = "(-) Despesa Fixa", [Despesa_Fixa],
			            LinhaSelecionada = "(-) Despesa Fixa Administrativa", _DespFixaAdmRateada,
			            LinhaSelecionada = "(-) Despesa Variável", [Despesa_Variavel],
			            LinhaSelecionada = "(-) Despesa com Pessoal", [Despesa_Pessoal],
			            LinhaSelecionada = "(-) Marketing/Comercial", [Marketing_Comercial],
			            LinhaSelecionada = "(=) Lucro Operacional", IF(NivelDetalhe, BLANK(), _LucroOperacional),
			            LinhaSelecionada = "(+) Receita Financeira", [Receita_Financeira],
			            LinhaSelecionada = "(-) Despesa Financeira", [Despesa_Financeira],
			            LinhaSelecionada = "(=) Resultado do Exercício", IF(NivelDetalhe, BLANK(), _Resultado),
			            BLANK()
			        ),
			        BLANK()
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: b5cdf777-1c4b-4ae9-8fae-1ed1223dc612

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure É_Subtotal =
			
			VAR LinhaAtual = SELECTEDVALUE(dEstruturaDRE[Linha])
			RETURN IF(
			    LinhaAtual IN {
			        "(=) Lucro Bruto",
			        "(=) Lucro Operacional",
			        "(=) Resultado do Exercício",
			        "(=) Receita Líquida"
			    },
			    1,
			    0
			)
		formatString: 0
		lineageTag: 14a77d66-c093-486f-92d4-2d0877f6995c

	/// T01 coluna Mes = item Total do grupo Analise DRE.
	measure DRE_Mes_Valor = CALCULATE( [Valor_DRE], 'Análise DRE'[Análise DRE] = "Total" )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 5eac3da6-27a6-483a-b73f-005ebe3830d1

	/// T01 coluna % (sem sinal, como no relatorio entregue).
	measure DRE_Mes_Pct = CALCULATE( [Valor_DRE], 'Análise DRE'[Análise DRE] = "%" )
		formatString: 0.0%;0.0%;0.0%
		displayFolder: Relatorio
		lineageTag: 214ab356-916b-472d-b43b-b53b38e9d4c5

	/// T01 coluna Media 6 meses.
	measure DRE_6M_Media = CALCULATE( [Valor_DRE], 'Análise DRE'[Análise DRE] = "Média 6M" )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 62b4ee45-2834-4f38-9c08-7d95badf711c

