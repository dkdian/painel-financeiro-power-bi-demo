	column Ano_Mês_Num
		formatString: 0
		lineageTag: e258c1ed-4ce2-4555-8c60-30ac628b42f0
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Ano_Mês_Num]

		annotation SummarizationSetBy = Automatic

	column Trimestre
		lineageTag: ec0da9c1-972c-428b-810c-8b778bdf36ce
		summarizeBy: none
		isNameInferred
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	column Mes_Com_Dados =
			VAR _AnoMes = dCalendario[Ano_Mês_Num]
			RETURN
			    IF(
			        CALCULATE(
			            COUNTROWS( ControleFinanceiro ),
			            FILTER( ALL( ControleFinanceiro ), YEAR( ControleFinanceiro[Realiz.] ) * 100 + MONTH( ControleFinanceiro[Realiz.] ) = _AnoMes )
			        ) > 0,
			        "Sim", "Não"
			    )
		dataType: string
		isHidden
		lineageTag: fc444780-9fc4-47f2-a388-714be45b6f34

	partition dCalendario = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR( DATE( 2025, 1, 1 ), DATE( MAX( YEAR( MAX( ControleFinanceiro[Realiz.] ) ), 2026 ), 12, 31 ) ),
				    "Ano", YEAR( [Date] ),
				    "Mês_Num", MONTH( [Date] ),
				    "Mês_Nome", UPPER( LEFT( FORMAT( [Date], "mmm" ), 1 ) ) & MID( FORMAT( [Date], "mmm" ), 2, 2 ),
				    "Ano_Mês", UPPER( LEFT( FORMAT( [Date], "mmm" ), 1 ) ) & MID( FORMAT( [Date], "mmm/yy" ), 2, 10 ),
				    "Ano_Mês_Num", YEAR( [Date] ) * 100 + MONTH( [Date] ),
				    "Trimestre", "T" & FORMAT( [Date], "q" )
				)

	annotation PBI_Id = c52900423e3f4107af3671e24972b125

