table dCategoriasGrafico
	lineageTag: 73ed17de-2f9d-4810-8a2c-d5af50060cf9

	measure Plot_GastoVsReceita = ```
			
			VAR CategoriaSelecionada = SELECTEDVALUE(dCategoriasGrafico[Categoria_Graf])
			VAR ReceitaBase = [Receita_Operacional]
			
			VAR ValorFatia = 
			    SWITCH(
			        CategoriaSelecionada,
			        "(-) Custo Operacional", ABS([Custo_Operacional]),
			        "(-) Despesa com Pessoal", ABS([Despesa_Pessoal]),
			        "(-) Despesa Fixa", ABS([Despesa_Fixa]),
			        "(-) Tributo", ABS([Tributo]),
			        "(-) Despesa Variável", ABS([Despesa_Variavel]),
			        "(-) Marketing/Comercial", ABS([Marketing_Comercial]),
			        "(-) Despesa Financeira", ABS([Despesa_Financeira]),
			        -- Como na pizza do Excel: prejuízo aparece como fatia (valor absoluto);
			        -- o sinal negativo vai no rótulo, pela expressão de formato.
			        "Resultado", ABS([Resultado_Exercicio]),
			        BLANK()
			    )
			
			RETURN 
			    DIVIDE(ValorFatia, ReceitaBase, 0)
			```
		lineageTag: 78e0a5b1-83fd-4998-a038-c52aad078d76

		formatStringDefinition =
				IF(
				    SELECTEDVALUE( dCategoriasGrafico[Categoria_Graf] ) = "Resultado" && [Resultado_Exercicio] < 0,
				    "-0.00%",
				    "0.00%;-0.00%;0.00%"
				)

	/// G08. Plot_GastoVsReceita do ano ate o mes mais recente com lancamento (nunca DATESYTD puro).
	measure Plot_GastoVsReceita_Ano =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			RETURN
			    CALCULATE(
			        [Plot_GastoVsReceita],
			        DATESBETWEEN( dCalendario[Date], DATE( YEAR( _RefData ), 1, 1 ), _RefData )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Relatorio
		lineageTag: 0586eb77-87dc-4afd-a270-c945cf6483cb

	/// Plot_GastoVsReceita do periodo selecionado; sem selecao, so do ultimo mes com dados (Excel Graficos!I30:I37).
	measure Plot_GastoVsReceita_Mes =
			IF( ISCROSSFILTERED( dCalendario[Ano_Mês_Num] ),
			    [Plot_GastoVsReceita],
			    VAR _m = [Painel_Mes_Ref]
			    RETURN CALCULATE( [Plot_GastoVsReceita], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _m ) )
		displayFolder: Painel
		lineageTag: f8da1406-5e9c-4bcd-9438-6c7660d959c6

		formatStringDefinition = IF( SELECTEDVALUE( dCategoriasGrafico[Categoria_Graf] ) = "Resultado" && [Resultado_Mes] < 0, "-0.00%", "0.00%;-0.00%;0.00%" )

	column ID_Graf
		dataType: int64
		formatString: 0
