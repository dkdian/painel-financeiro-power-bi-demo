	/// G07. Resultado acumulado desde o inicio da janela de 12 meses ate o mes do eixo (linha).
	measure Eixo12M_Resultado_Acumulado =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			VAR _Ref = YEAR( _RefData ) * 12 + MONTH( _RefData )
			VAR _I = SELECTEDVALUE( dEixoMes[Eixo_Indice] )
			RETURN
			    IF( _I > _Ref - 12 && _I <= _Ref,
			        CALCULATE(
			            [Resultado_Exercicio],
			            REMOVEFILTERS( dCalendario ),
			            FILTER( ALL( dCalendario[Ano], dCalendario[Mês_Num] ),
			                VAR _k = dCalendario[Ano] * 12 + dCalendario[Mês_Num]
			                RETURN _k > _Ref - 12 && _k <= _I )
			        ) )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio\Eixo12M
		lineageTag: 2ce87ac2-08d8-4026-b0fb-4bc35c2f1d9a

	/// G07. Igual a Eixo12M_Resultado_Acumulado, mas so preenchido no mes de maior valor, no de menor valor e no mes mais recente da janela (para rotular so esses 3 pontos na linha, como o Excel). Serie auxiliar so para rotulo; a linha visivel usa Eixo12M_Resultado_Acumulado.
	measure Eixo12M_Resultado_Acum_Rotulo =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			VAR _Ref = YEAR( _RefData ) * 12 + MONTH( _RefData )
			VAR _I = SELECTEDVALUE( dEixoMes[Eixo_Indice] )
			VAR _EmJanela = _I > _Ref - 12 && _I <= _Ref
			VAR _Meses =
			    FILTER(
			        CALCULATETABLE( VALUES( dEixoMes[Eixo_Indice] ), ALL( dEixoMes ) ),
			        dEixoMes[Eixo_Indice] > _Ref - 12 && dEixoMes[Eixo_Indice] <= _Ref
			    )
			VAR _Tab =
			    ADDCOLUMNS(
			        _Meses,
			        "@Acum",
			            VAR _idx = dEixoMes[Eixo_Indice]
			            RETURN CALCULATE( [Eixo12M_Resultado_Acumulado], ALL( dEixoMes ), dEixoMes[Eixo_Indice] = _idx )
			    )
			VAR _MaxAcum = MAXX( _Tab, [@Acum] )
			VAR _MinAcum = MINX( _Tab, [@Acum] )
			VAR _ThisAcum = [Eixo12M_Resultado_Acumulado]
			RETURN
			    IF( _EmJanela && ( _ThisAcum = _MaxAcum || _ThisAcum = _MinAcum || _I = _Ref ), _ThisAcum )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio\Eixo12M
		lineageTag: 99f8909d-7726-4213-a0fa-7a3e6e27b1a2

	/// Rotulo do periodo dos graficos de 12 meses (R01,R04,R06,R07): mes inicial ao mes final da janela (o final e o ultimo mes com Realiz. no contexto).
	measure Rotulo_Janela_12M =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			VAR _Ref = YEAR( _RefData ) * 12 + MONTH( _RefData )
			VAR _PrimeiroData = MIN( ControleFinanceiro[Realiz.] )
			VAR _PrimeiroIdx = YEAR( _PrimeiroData ) * 12 + MONTH( _PrimeiroData )
			VAR _IniIdx = MAX( _Ref - 11, _PrimeiroIdx )
			VAR _IniAno = INT( ( _IniIdx - 1 ) / 12 )
			VAR _IniMes = _IniIdx - _IniAno * 12
			VAR _IniData = DATE( _IniAno, _IniMes, 1 )
			VAR _NomeIni = UPPER( LEFT( FORMAT( _IniData, "mmmm", "pt-BR" ), 1 ) ) & MID( FORMAT( _IniData, "mmmm", "pt-BR" ), 2, 20 ) & "/" & YEAR( _IniData )
			VAR _NomeFim = UPPER( LEFT( FORMAT( _RefData, "mmmm", "pt-BR" ), 1 ) ) & MID( FORMAT( _RefData, "mmmm", "pt-BR" ), 2, 20 ) & "/" & YEAR( _RefData )
			RETURN
			    IF( ISBLANK( _RefData ), BLANK(), _NomeIni & " a " & _NomeFim & " (12 meses até " & _NomeFim & ")" )
		displayFolder: Relatorio\Eixo12M
		lineageTag: 17580423-1141-479b-8c88-ff9a76943487

	/// Texto explicativo da pagina R00: o que cada tipo de visual esta mostrando, dado o(s) mes(es) escolhido(s) no segmentador.
	measure Texto_Periodo_Analise =
			"Período nas pizzas e tabelas: " & [Rotulo_Periodo] & UNICHAR( 10 ) &
			"Gráficos de 12 meses (Receita, Markup, Custo/Competência, Resultado): " & [Rotulo_Janela_12M] & UNICHAR( 10 ) &
			"Médias de 3, 6 e 12 meses e a coluna Ano contam a partir do último mês escolhido acima."
		displayFolder: Relatorio
		lineageTag: 50a874c6-2006-42b3-889e-0d42779aefb3

	/// R01. Inicio sugerido do eixo Y (80% do menor valor da janela de 12 meses, arredondado para baixo em centenas de mil), para dar folga como no Excel.
	measure Eixo12M_Receita_EixoMin =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			VAR _Ref = YEAR( _RefData ) * 12 + MONTH( _RefData )
			VAR _Base = CALCULATETABLE( DISTINCT( dEixoMes ), ALL( dEixoMes ) )
			VAR _Janela = FILTER( _Base, dEixoMes[Eixo_Indice] > _Ref - 12 && dEixoMes[Eixo_Indice] <= _Ref )
			VAR _ComReceita =
			    ADDCOLUMNS(
			        _Janela,
			        "@Rec",
			            VAR _m = dEixoMes[Eixo_Ano_Mes_Num]
			            RETURN CALCULATE( [Receita_Operacional], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _m )
			    )
			VAR _Min = MINX( _ComReceita, [@Rec] )
			RETURN IF( NOT ISBLANK( _Min ), ROUNDDOWN( _Min * 0.8, -5 ) )
		displayFolder: Relatorio\Eixo12M
		lineageTag: 9f892622-fd94-4c2d-857a-85de832c354a

	/// R04. Inicio sugerido do eixo Y (90% do menor markup da janela, 1 casa).
	measure Eixo12M_Markup_EixoMin =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			VAR _Ref = YEAR( _RefData ) * 12 + MONTH( _RefData )
			VAR _Base = CALCULATETABLE( DISTINCT( dEixoMes ), ALL( dEixoMes ) )
			VAR _Janela = FILTER( _Base, dEixoMes[Eixo_Indice] > _Ref - 12 && dEixoMes[Eixo_Indice] <= _Ref )
			VAR _ComMk =
			    ADDCOLUMNS(
			        _Janela,
			        "@Mk",
			            VAR _m = dEixoMes[Eixo_Ano_Mes_Num]
			            RETURN CALCULATE( [Markup_Competencia], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _m )
			    )
			VAR _Min = MINX( FILTER( _ComMk, NOT ISBLANK( [@Mk] ) ), [@Mk] )
			RETURN IF( NOT ISBLANK( _Min ), ROUNDDOWN( _Min * 0.9, 1 ) )
		displayFolder: Relatorio\Eixo12M
		lineageTag: 2e642e1c-2d57-4743-b055-6fff0588a5a6

	/// R04. Fim sugerido do eixo Y (110% do maior markup da janela, 1 casa), para o rotulo do ponto mais alto nao encostar na linha.
	measure Eixo12M_Markup_EixoMax =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			VAR _Ref = YEAR( _RefData ) * 12 + MONTH( _RefData )
			VAR _Base = CALCULATETABLE( DISTINCT( dEixoMes ), ALL( dEixoMes ) )
			VAR _Janela = FILTER( _Base, dEixoMes[Eixo_Indice] > _Ref - 12 && dEixoMes[Eixo_Indice] <= _Ref )
			VAR _ComMk =
			    ADDCOLUMNS(
			        _Janela,
			        "@Mk",
			            VAR _m = dEixoMes[Eixo_Ano_Mes_Num]
			            RETURN CALCULATE( [Markup_Competencia], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _m )
			    )
			VAR _Max = MAXX( FILTER( _ComMk, NOT ISBLANK( [@Mk] ) ), [@Mk] )
			RETURN IF( NOT ISBLANK( _Max ), ROUNDUP( _Max * 1.1, 1 ) )
		displayFolder: Relatorio\Eixo12M
		lineageTag: 36c1672e-eb89-41f6-a0d2-0ffb03168a65

	/// R02 (Pareto). Participacao do grupo (12 maiores clientes + Outros) na receita operacional do periodo selecionado.
	measure Receita_Part_Cliente = DIVIDE( [Receita_Operacional], CALCULATE( [Receita_Operacional], ALLSELECTED( ControleFinanceiro[Cliente_Pareto], ControleFinanceiro[Cliente_Pareto_Ordem] ) ) )
		formatString: 0.0%
		displayFolder: Relatorio
		lineageTag: 49974743-17f0-48d3-bf92-678fe30ce5f9

	/// R02 (Pareto). Participacao acumulada por posicao (12 maiores clientes em ordem, Outros sempre por ultimo fechando em 100%).
	measure Receita_Pareto_Acum =
			VAR _MinhaOrdem = MIN( ControleFinanceiro[Cliente_Pareto_Ordem] )
			VAR _Tab =
			    ADDCOLUMNS(
			        SUMMARIZE( ALLSELECTED( ControleFinanceiro ), ControleFinanceiro[Cliente_Pareto], ControleFinanceiro[Cliente_Pareto_Ordem] ),
			        "@r", CALCULATE( [Receita_Operacional] )
			    )
			RETURN
			    DIVIDE( SUMX( FILTER( _Tab, [Cliente_Pareto_Ordem] <= _MinhaOrdem ), [@r] ), SUMX( _Tab, [@r] ) )
		formatString: 0%
		displayFolder: Relatorio
		lineageTag: 63688a72-2364-45a4-bec4-9471f6fd4b11

	/// Variacao da Receita_Competencia do mes em contexto contra o mes anterior com competencia lancada (o mes anterior no calendario). Vazio se o mes nao tem competencia. Usada no texto do relatorio mensal (Python so formata).
	measure Receita_Competencia_Var_MoM =
			VAR _Cur = SELECTEDVALUE( dCalendario[Ano_Mês_Num] )
			VAR _Ant =
			    MAXX(
			        FILTER( ALL( dCalendario[Ano_Mês_Num] ), dCalendario[Ano_Mês_Num] < _Cur ),
			        dCalendario[Ano_Mês_Num]
			    )
			VAR _ValAnt =
			    CALCULATE( [Receita_Competencia], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _Ant )
			RETURN
			    DIVIDE( [Receita_Competencia] - _ValAnt, _ValAnt )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Relatorio
		lineageTag: a24fe9b0-0399-450a-a650-5db121c0f81a

	/// Receita por competencia de cada mes da janela de 12 meses (eixo dEixoMes) que termina no mes de referencia. Vazio fora da janela ou sem competencia lancada. Grafico G01 do relatorio mensal.
	measure Eixo12M_Receita_Competencia =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			VAR _Ref = YEAR( _RefData ) * 12 + MONTH( _RefData )
			VAR _I = SELECTEDVALUE( dEixoMes[Eixo_Indice] )
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			RETURN
			    IF( _I > _Ref - 12 && _I <= _Ref,
			        CALCULATE( [Receita_Competencia], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _M ) )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 77b106a0-6608-444a-846a-67d4bd8acc15

	/// Variacao da receita por competencia de cada mes da janela contra o mes anterior. Vazio se nao houver os dois meses. So o sinal define a cor do rotulo no G01.
	measure Eixo12M_Receita_Competencia_MoM =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			VAR _Ref = YEAR( _RefData ) * 12 + MONTH( _RefData )
			VAR _I = SELECTEDVALUE( dEixoMes[Eixo_Indice] )
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			VAR _Ant = MAXX( FILTER( ALL( dCalendario[Ano_Mês_Num] ), dCalendario[Ano_Mês_Num] < _M ), dCalendario[Ano_Mês_Num] )
			VAR _Atual = CALCULATE( [Receita_Competencia], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _M )
			VAR _ValAnt = CALCULATE( [Receita_Competencia], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _Ant )
			RETURN
			    IF( _I > _Ref - 12 && _I <= _Ref, DIVIDE( _Atual - _ValAnt, _ValAnt ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Relatorio
		lineageTag: 397c5932-14b6-436e-ae79-7a718d62136d

	/// DFC: Entrada FFE menos Saida FFE (Detalhamento das categorias Entrada e Saida). Linha 'Fundo Financeiro Empresarial' da tabela DFC do relatorio. Junto com DFC_Aplicacao soma a linha 10 (Entrada/Saida) do Valor_DFC.
	measure DFC_Fundo_Financeiro_Empresarial =
			CALCULATE( SUM( ControleFinanceiro[Valor] ), ControleFinanceiro[Categoria] = "Entrada", ControleFinanceiro[Detalhamento/Categoria II] = "Entrada FFE" )
			    - CALCULATE( SUM( ControleFinanceiro[Valor] ), ControleFinanceiro[Categoria] = "Saída", ControleFinanceiro[Detalhamento/Categoria II] = "Saída FFE" )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 9af8dec2-2220-4a68-8b07-559dc3271979

	/// DFC: tudo que e Entrada/Saida e NAO e Fundo Financeiro (Entrada/Saida de Conta, Lhoist, ajustes de saldo...). Total das categorias Entrada e Saida menos DFC_Fundo_Financeiro_Empresarial; as duas linhas sempre somam a linha 10 (Entrada/Saida) do Valor_DFC. Regra alterada em 02/10/2026 (antes so Detalhamento 'de Conta').
	measure DFC_Aplicacao =
			VAR _Total =
			    CALCULATE( SUM( ControleFinanceiro[Valor] ), ControleFinanceiro[Categoria] = "Entrada" )
			    - CALCULATE( SUM( ControleFinanceiro[Valor] ), ControleFinanceiro[Categoria] = "Saída" )
			RETURN
			    _Total - [DFC_Fundo_Financeiro_Empresarial]
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: c83ef270-bcd6-4edc-bd47-aec2fd3516b2

	/// DRE (visao Standard): media dos ultimos 3 meses ate o mes em contexto. Tabela DRE Gerencial do relatorio.
	measure DRE_3M_Media = CALCULATE( [Valor_DRE], 'Análise DRE'[Análise DRE] = "Média 3M" )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: efad01b0-9011-45eb-a5c4-bfd3649a0667

	/// DRE (visao Standard): percentual da media de 3 meses sobre a receita.
	measure DRE_3M_Pct = CALCULATE( [Valor_DRE], 'Análise DRE'[Análise DRE] = "% 3M" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Relatorio
		lineageTag: c43df606-284b-4d2f-92b1-584788ca7d67

	/// Resultado acumulado desde janeiro do ano do mes de referencia, ate cada mes da janela (so meses do ano de referencia; vazio nos de anos anteriores). Linha do grafico G07.
	measure Eixo12M_Resultado_Acum_Ano =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			VAR _Ref = YEAR( _RefData ) * 12 + MONTH( _RefData )
			VAR _AnoRef = YEAR( _RefData )
			VAR _I = SELECTEDVALUE( dEixoMes[Eixo_Indice] )
			RETURN
			    IF( _I > _AnoRef * 12 && _I <= _Ref,
			        CALCULATE(
			            [Resultado_Exercicio],
			            REMOVEFILTERS( dCalendario ),
			            FILTER( ALL( dCalendario[Ano], dCalendario[Mês_Num] ),
			                VAR _k = dCalendario[Ano] * 12 + dCalendario[Mês_Num]
			                RETURN _k > _AnoRef * 12 && _k <= _I )
			        ) )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 2040c10d-0285-4866-8500-fc0fe52d305e

	/// Benchmark: % da receita (media de 6 meses) de Despesa Variavel + Despesa Financeira, em positivo. Mesma conta da aba Graficos da planilha (S8+S13).
	measure Bench_VarFin_6M =
			VAR _V = CALCULATE( [DRE_6M_Pct], TREATAS( { "Standard" }, dEstruturaDRE[Visão] ), TREATAS( { 7 }, dEstruturaDRE[ID] ) )
			VAR _F = CALCULATE( [DRE_6M_Pct], TREATAS( { "Standard" }, dEstruturaDRE[Visão] ), TREATAS( { 12 }, dEstruturaDRE[ID] ) )
			RETURN -( COALESCE( _V, 0 ) + COALESCE( _F, 0 ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Relatorio
		lineageTag: 19273c77-b800-4385-a845-59f3d6a9c81d

	/// Mes de referencia (AAAAMM) = ultimo mes com lancamento dentro do Periodo selecionado; ignora filtros de categoria, cozinha, cliente e conta (so o calendario conta). Sem selecao: ultimo mes com dados.
	measure Painel_Mes_Ref =
			VAR _d =
			    CALCULATE(
			        MAX( ControleFinanceiro[Realiz.] ),
			        REMOVEFILTERS( ControleFinanceiro[C. C.] ),
			        REMOVEFILTERS( ControleFinanceiro[  Fornecedor/ Cliente] ),
			        REMOVEFILTERS( ControleFinanceiro[Descrição] ),
			        REMOVEFILTERS( ControleFinanceiro[Detalhamento/Categoria II] ),
			        REMOVEFILTERS( ControleFinanceiro[Grupo] ),
			        REMOVEFILTERS( ControleFinanceiro[Categoria] ),
			        REMOVEFILTERS( ControleFinanceiro[Conta] ),
			        REMOVEFILTERS( ControleFinanceiro[Cliente_Pareto] ),
			        REMOVEFILTERS( ControleFinanceiro[Cliente_Pareto_Ordem] )
			    )
			RETURN IF( NOT ISBLANK( _d ), YEAR( _d ) * 100 + MONTH( _d ) )
		formatString: 0
		isHidden
		displayFolder: Painel
		lineageTag: 9e2e5a28-1764-4a44-96d1-68c1cb757f59

	/// Ultimo mes (AAAAMM) com receita por competencia lancada, ate o mes de referencia.
	measure Painel_Mes_Ref_Comp =
			VAR _Ref = [Painel_Mes_Ref]
			RETURN
			    MAXX(
			        FILTER(
			            ALL( Receita_Competencia_Manual ),
			            YEAR( Receita_Competencia_Manual[Data_Competencia] ) * 100 + MONTH( Receita_Competencia_Manual[Data_Competencia] ) <= _Ref
			                && Receita_Competencia_Manual[Valor_Competencia] > 0
			        ),
			        YEAR( Receita_Competencia_Manual[Data_Competencia] ) * 100 + MONTH( Receita_Competencia_Manual[Data_Competencia] )
			    )
		formatString: 0
		isHidden
		displayFolder: Painel
		lineageTag: 59668547-ba0b-4687-8a7c-7433ad2eed7c

	/// Carimbo do cabecalho: data do ultimo lancamento da planilha, sem filtros.
	measure Txt_Dados_Ate = "Dados até " & FORMAT( CALCULATE( MAX( ControleFinanceiro[Realiz.] ), ALL( ControleFinanceiro ) ), "dd/mm/yyyy" )
		displayFolder: Painel
		lineageTag: f9211bed-257b-48b8-9762-2f745127ca5d

	/// Subtitulo: mes de referencia (sem selecao) ou periodo selecionado.
	measure Sub_Mes =
			VAR _ini = [Painel_Mes_Ini]
			VAR _fim = [Painel_Mes_Ref]
			VAR _lblFim = LOOKUPVALUE( dCalendario[Ano_Mês], dCalendario[Ano_Mês_Num], _fim )
			VAR _lblIni = LOOKUPVALUE( dCalendario[Ano_Mês], dCalendario[Ano_Mês_Num], _ini )
			RETURN IF( ISCROSSFILTERED( dCalendario[Ano_Mês_Num] ) && _ini <> _fim, "Período: " & _lblIni & " a " & _lblFim, "Mês de referência: " & _lblFim )
		displayFolder: Painel
		lineageTag: c368394f-c91b-41e4-8b42-0ef367e3c62b

	/// Subtitulo: periodo do acumulado do ano.
	measure Sub_Acum_Ano =
			VAR _Ref = [Painel_Mes_Ref]
			RETURN "Acumulado do ano: Jan a " & LOOKUPVALUE( dCalendario[Ano_Mês], dCalendario[Ano_Mês_Num], _Ref )
		displayFolder: Painel
		lineageTag: b5c5cce7-c204-4056-8264-0d6d3784f412

	/// Subtitulo: mes da ultima receita por competencia lancada.
	measure Sub_Competencia = "Competência · " & LOOKUPVALUE( dCalendario[Ano_Mês], dCalendario[Ano_Mês_Num], [Painel_Mes_Ref_Comp] )
		displayFolder: Painel
		lineageTag: 768cdf42-4cae-4856-a552-5b4bc3634bee

	/// Receita_Operacional do periodo selecionado; sem selecao, so do ultimo mes com dados.
	measure Receita_Operacional_Mes =
			IF( ISCROSSFILTERED( dCalendario[Ano_Mês_Num] ),
			    [Receita_Operacional],
			    VAR _m = [Painel_Mes_Ref]
			    RETURN CALCULATE( [Receita_Operacional], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _m ) )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Painel
		lineageTag: e7d36d5e-e888-4515-8472-37b14cf73cef

	/// Resultado_Exercicio do periodo selecionado; sem selecao, so do ultimo mes com dados.
	measure Resultado_Mes =
			IF( ISCROSSFILTERED( dCalendario[Ano_Mês_Num] ),
			    [Resultado_Exercicio],
			    VAR _m = [Painel_Mes_Ref]
			    RETURN CALCULATE( [Resultado_Exercicio], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _m ) )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Painel
		lineageTag: ccb660c8-e93e-473c-bd59-fe93cfe44199

	/// Resultado_Exercicio de janeiro do ano ate o mes de referencia.
	measure Resultado_Acum_Ano_Mes =
			VAR _m = [Painel_Mes_Ref]
			VAR _ini = INT( _m / 100 ) * 100 + 1
			RETURN CALCULATE( [Resultado_Exercicio], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] >= _ini, dCalendario[Ano_Mês_Num] <= _m )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Painel
		lineageTag: 4455429d-9008-445d-bd51-cf668f800fa4

	/// Markup por competencia do ultimo mes com competencia lancada (Excel Graficos!C28).
	measure Markup_Competencia_Ult =
			VAR _m = [Painel_Mes_Ref_Comp]
			RETURN CALCULATE( [Markup_Competencia], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _m )
		formatString: #,0.00"x";-#,0.00"x";0.00"x"
		displayFolder: Painel
		lineageTag: a478193e-573d-47e4-8c20-0902a57d0f9a

	/// Verde se o resultado do mes e positivo, vermelho se negativo.
	measure Cor_Resultado_Mes = IF( [Resultado_Mes] < 0, "#C62828", "#1E8E3E" )
		displayFolder: Painel
		lineageTag: 1ee508ba-efd1-4524-b41e-fd61e802f6ab

	/// Verde se o resultado acumulado do ano e positivo, vermelho se negativo.
	measure Cor_Resultado_Acum = IF( [Resultado_Acum_Ano_Mes] < 0, "#C62828", "#1E8E3E" )
		displayFolder: Painel
		lineageTag: f95554a0-45c1-4652-9464-ba11d35e9467

	/// Grafico 5. Detalhamento Salarios (Despesa.com.Pessoal), positivo, nos 12 meses ate o mes de referencia. Mesma regra de Graficos!A73.
	measure Eixo12M_Pessoal_Salarios =
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			RETURN
			    IF( [Painel_Mostrar] = 1,
			        CALCULATE( SUM( ControleFinanceiro[Valor] ), REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _M,
			            ControleFinanceiro[Categoria] = "Despesa.com.Pessoal", ControleFinanceiro[Detalhamento/Categoria II] = "Salários" ) )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Painel\Eixo12M
		lineageTag: 55c86e6d-d557-48a2-97ed-dadc8beefd02

	/// Grafico 5. Encargos + Provisoes (Despesa.com.Pessoal), positivo, 12 meses. Mesma regra de Graficos!A74.
	measure Eixo12M_Pessoal_Encargos =
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			RETURN
			    IF( [Painel_Mostrar] = 1,
			        CALCULATE( SUM( ControleFinanceiro[Valor] ), REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _M,
			            ControleFinanceiro[Categoria] = "Despesa.com.Pessoal", ControleFinanceiro[Detalhamento/Categoria II] IN { "Encargos", "Provisões" } ) )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Painel\Eixo12M
		lineageTag: 1ba34742-aa8f-42bd-823d-f7b4101a0b93

	/// Grafico 5. Demais detalhamentos de Despesa.com.Pessoal (tudo menos Salarios, Encargos e Provisoes), positivo, 12 meses. Mesma regra de Graficos!A77.
	measure Eixo12M_Pessoal_Outros =
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			RETURN
			    IF( [Painel_Mostrar] = 1,
			        CALCULATE( SUM( ControleFinanceiro[Valor] ), REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _M,
			            ControleFinanceiro[Categoria] = "Despesa.com.Pessoal", NOT ( ControleFinanceiro[Detalhamento/Categoria II] IN { "Salários", "Encargos", "Provisões" } ) ) )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Painel\Eixo12M
		lineageTag: 67a50523-76b4-4cb7-be54-8d55801eff00

	/// Grafico 9. Markup por competencia por mes: com Periodo selecionado, os meses selecionados ate o ultimo com competencia; sem selecao, de janeiro ao ultimo mes com competencia (Excel Graficos!C28:J28).
	measure Eixo_Ano_Markup =
			VAR _RefC = [Painel_Mes_Ref_Comp]
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			VAR _ok =
			    IF( ISCROSSFILTERED( dCalendario[Ano_Mês_Num] ),
			        _M IN VALUES( dCalendario[Ano_Mês_Num] ) && _M <= _RefC,
			        _M >= INT( _RefC / 100 ) * 100 + 1 && _M <= _RefC )
			RETURN IF( _ok, CALCULATE( [Markup_Competencia], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _M ) )
		formatString: #,0.00"x";-#,0.00"x";0.00"x"
		displayFolder: Painel\Eixo12M
		lineageTag: e63b95a0-d202-4233-995d-663b7be1fbaa

	/// Grafico 11. Custo operacional / receita por competencia por mes: com Periodo selecionado, os meses selecionados ate o ultimo com competencia; sem selecao, de janeiro ao ultimo mes com competencia (Excel Graficos!C25:J25).
	measure Eixo_Ano_Custo_Competencia =
			VAR _RefC = [Painel_Mes_Ref_Comp]
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			VAR _ok =
			    IF( ISCROSSFILTERED( dCalendario[Ano_Mês_Num] ),
			        _M IN VALUES( dCalendario[Ano_Mês_Num] ) && _M <= _RefC,
			        _M >= INT( _RefC / 100 ) * 100 + 1 && _M <= _RefC )
			RETURN IF( _ok, CALCULATE( [Custo_sobre_Receita_Competencia], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _M ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Painel\Eixo12M
		lineageTag: 7f994c94-efc5-488f-8241-270975eb1d78

	/// Primeiro mes (AAAAMM) com lancamento dentro do Periodo selecionado; ignora filtros de categoria, cozinha, cliente e conta.
	measure Painel_Mes_Ini =
			VAR _d =
			    CALCULATE(
			        MIN( ControleFinanceiro[Realiz.] ),
			        REMOVEFILTERS( ControleFinanceiro[C. C.] ),
			        REMOVEFILTERS( ControleFinanceiro[  Fornecedor/ Cliente] ),
			        REMOVEFILTERS( ControleFinanceiro[Descrição] ),
			        REMOVEFILTERS( ControleFinanceiro[Detalhamento/Categoria II] ),
			        REMOVEFILTERS( ControleFinanceiro[Grupo] ),
			        REMOVEFILTERS( ControleFinanceiro[Categoria] ),
			        REMOVEFILTERS( ControleFinanceiro[Conta] ),
			        REMOVEFILTERS( ControleFinanceiro[Cliente_Pareto] ),
			        REMOVEFILTERS( ControleFinanceiro[Cliente_Pareto_Ordem] )
			    )
			RETURN IF( NOT ISBLANK( _d ), YEAR( _d ) * 100 + MONTH( _d ) )
		formatString: 0
		isHidden
		displayFolder: Painel
		lineageTag: 22ea639b-094e-41a1-b0ee-8e5f9870aa65

	/// 1 se o mes do eixo (dEixoMes) deve aparecer nos graficos mensais: com Periodo selecionado, so os meses selecionados; sem selecao, os 12 meses ate o mes de referencia.
	measure Painel_Mostrar =
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			VAR _Mref = [Painel_Mes_Ref]
			VAR _I = INT( _M / 100 ) * 12 + MOD( _M, 100 )
			VAR _Ref = INT( _Mref / 100 ) * 12 + MOD( _Mref, 100 )
			RETURN
			    IF( ISCROSSFILTERED( dCalendario[Ano_Mês_Num] ),
			        IF( _M IN VALUES( dCalendario[Ano_Mês_Num] ), 1 ),
			        IF( _I > _Ref - 12 && _I <= _Ref, 1 ) )
		formatString: 0
		isHidden
		displayFolder: Painel
		lineageTag: a67ca9b0-fad5-4066-a9aa-063b2b414cf0

	/// Receita_Operacional por mes do eixo, so nos meses a mostrar (Painel_Mostrar).
	measure Painel_Receita_Eixo =
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			RETURN IF( [Painel_Mostrar] = 1, CALCULATE( [Receita_Operacional], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _M ) )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Painel\Eixo12M
		lineageTag: 4fae3bd5-17bd-4400-97c8-c30b88442d8e

	/// Receita por competencia por mes do eixo, so nos meses a mostrar (Painel_Mostrar). Vazio sem competencia lancada.
	measure Painel_Receita_Comp_Eixo =
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			RETURN IF( [Painel_Mostrar] = 1, CALCULATE( [Receita_Competencia], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _M ) )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Painel\Eixo12M
		lineageTag: 80b729b4-1852-44e1-ad5a-568a781d169d

	/// Resultado_Exercicio por mes do eixo, so nos meses a mostrar (Painel_Mostrar).
	measure Painel_Resultado_Eixo =
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			RETURN IF( [Painel_Mostrar] = 1, CALCULATE( [Resultado_Exercicio], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _M ) )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Painel\Eixo12M
		lineageTag: 708a2d54-b351-43fb-8c29-fb1a98975cea

	/// Resultado acumulado do ano (de janeiro ate cada mes do eixo), so nos meses a mostrar (Painel_Mostrar).
	measure Painel_Resultado_Acum_Eixo =
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			VAR _ini = INT( _M / 100 ) * 100 + 1
			RETURN IF( [Painel_Mostrar] = 1, CALCULATE( [Resultado_Exercicio], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] >= _ini, dCalendario[Ano_Mês_Num] <= _M ) )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Painel\Eixo12M
		lineageTag: 47edf4a2-1415-4390-ad34-46c4ba33d45f

	/// Pareto de clientes: % acumulado da receita (no periodo selecionado; sem selecao, no mes de referencia), do maior cliente para o menor.
	measure Painel_Pareto_Acum =
			VAR _mine = [Receita_Operacional_Mes]
			VAR _tab = ADDCOLUMNS( ALLSELECTED( ControleFinanceiro[  Fornecedor/ Cliente] ), "@v", [Receita_Operacional_Mes] )
			VAR _tot = SUMX( _tab, [@v] )
			VAR _ac = SUMX( FILTER( _tab, [@v] >= _mine ), [@v] )
			RETURN IF( NOT ISBLANK( _mine ), DIVIDE( _ac, _tot ) )
		formatString: 0%
		displayFolder: Painel
		lineageTag: f6113965-719f-4518-a8e6-caf8c932b83f

