	measure Receita_Variacao_MoM = ```
			
			VAR ReceitaAtual = [Receita_Operacional]
			VAR ReceitaMesAnterior = 
			    CALCULATE(
			        [Receita_Operacional],
			        DATEADD( dCalendario[Date], -1, MONTH )
			    )
			RETURN 
			    DIVIDE(ReceitaAtual - ReceitaMesAnterior, ReceitaMesAnterior, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d8d4040c-8f64-4e65-b9a4-09344ba5c185

	measure Plot_Resultado_Acumulado =
			
			CALCULATE(
			    [Resultado_Exercicio],
			    DATESYTD( dCalendario[Date] )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: f615e09b-f0c3-4ac1-b8c0-0e55ab45f743

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Plot_Rótulo_MinMax =
			
			VAR _MesAtual = SELECTEDVALUE( dCalendario[Ano_Mês_Num] )
			
			VAR _TabelaMeses =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED( dCalendario[Ano_Mês_Num], dCalendario[Ano_Mês] ),
			            "@Acumulado", [Plot_Resultado_Acumulado]
			        ),
			        NOT ISBLANK( [@Acumulado] )
			    )
			
			VAR _MesDoMaximo = MAXX( TOPN( 1, _TabelaMeses, [@Acumulado], DESC ), dCalendario[Ano_Mês_Num] )
			VAR _MesDoMinimo = MAXX( TOPN( 1, _TabelaMeses, [@Acumulado], ASC  ), dCalendario[Ano_Mês_Num] )
			
			RETURN
			    IF(
			        _MesAtual = _MesDoMaximo || _MesAtual = _MesDoMinimo,
			        [Plot_Resultado_Acumulado],
			        BLANK()
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: bddd32ac-6251-468a-a24f-048242040d87

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Fluxo_Caixa_Liquido = ```
			
			VAR _Operacional = ([Receita_Operacional] + [Receita_Financeira]) + ([Tributo] + [Custo_Operacional] + [Despesa_Fixa] + [Despesa_Variavel] + [Despesa_Pessoal] + [Marketing_Comercial] + [Despesa_Financeira])
			
			-- Espelha a fórmula da coluna Saldo: venda de ativo marcada em [Detalhamento/Categoria II].
			VAR _Investimentos = 
			    CALCULATE(
			        SUM(ControleFinanceiro[Valor]),
			        ControleFinanceiro[Categoria] = "Investimento",
			        ControleFinanceiro[Detalhamento/Categoria II] <> "Venda de Ativo Imobilizado"
			    ) * -1 +
			    CALCULATE(
			        SUM(ControleFinanceiro[Valor]),
			        ControleFinanceiro[Categoria] = "Investimento",
			        ControleFinanceiro[Detalhamento/Categoria II] = "Venda de Ativo Imobilizado"
			    )
			
			VAR _Financiamentos = 
			    CALCULATE(SUM(ControleFinanceiro[Valor]), ControleFinanceiro[Categoria] = "Aporte") +
			    (CALCULATE(SUM(ControleFinanceiro[Valor]), ControleFinanceiro[Categoria] = "Retirada") * -1) +
			    CALCULATE(SUM(ControleFinanceiro[Valor]), ControleFinanceiro[Categoria] = "Entrada") +
			    (CALCULATE(SUM(ControleFinanceiro[Valor]), ControleFinanceiro[Categoria] = "Saída") * -1)
			
			RETURN 
			    _Operacional + _Investimentos + _Financiamentos
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: adac88cc-5d02-4b74-8d8d-ff477afb5864

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Custo_Operacional = CALCULATE([Valor_Total], ControleFinanceiro[Categoria] = "Custo.Operacional") * -1
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 871389f4-0816-4963-8dbd-cc338caf2c4b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Custo operacional (caixa) sobre receita por competência do mesmo ano-mês. Só faz sentido por mês; vazio no total. Gráfico 6.
	measure Custo_sobre_Receita_Competencia =
			
			VAR _AnoMes = SELECTEDVALUE( dCalendario[Ano_Mês_Num] )
			VAR _ReceitaComp =
			    CALCULATE(
			        SUM( Receita_Competencia_Manual[Valor_Competencia] ),
			        FILTER(
			            ALL( Receita_Competencia_Manual ),
			            YEAR( Receita_Competencia_Manual[Data_Competencia] ) * 100
			                + MONTH( Receita_Competencia_Manual[Data_Competencia] ) = _AnoMes
			        )
			    )
			RETURN
			    DIVIDE( -[Custo_Operacional], _ReceitaComp )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0f02d031-69a5-4c71-81fa-7732cccf4525

	/// Subtitulo dinamico dos visuais: 'Dezembro/2025' para um mes, 'Janeiro/2025 a Dezembro/2025' para varios. Ancorado em ControleFinanceiro[Realiz.] (nao no calendario).
	measure Rotulo_Periodo =
			VAR _Ini = MIN ( ControleFinanceiro[Realiz.] )
			VAR _Fim = MAX ( ControleFinanceiro[Realiz.] )
			VAR _TxtIni =
			    UPPER ( LEFT ( FORMAT ( _Ini, "mmmm", "pt-BR" ), 1 ) ) & MID ( FORMAT ( _Ini, "mmmm", "pt-BR" ), 2, 20 ) & "/" & YEAR ( _Ini )
			VAR _TxtFim =
			    UPPER ( LEFT ( FORMAT ( _Fim, "mmmm", "pt-BR" ), 1 ) ) & MID ( FORMAT ( _Fim, "mmmm", "pt-BR" ), 2, 20 ) & "/" & YEAR ( _Fim )
			RETURN
			    IF ( ISBLANK ( _Fim ), BLANK (), IF ( _TxtIni = _TxtFim, _TxtIni, _TxtIni & " a " & _TxtFim ) )
		lineageTag: fe3e9409-ab45-439f-a3fa-8dfebf413bae

	/// Receita por competencia do mes em contexto (Receita_Competencia_Manual). Vazio se nao houver valor. Ancorado em dCalendario[Ano_Mês_Num] como Custo_sobre_Receita_Competencia.
	measure Receita_Competencia =
			VAR _AnoMes = SELECTEDVALUE( dCalendario[Ano_Mês_Num] )
			VAR _Valor =
			    CALCULATE(
			        SUM( Receita_Competencia_Manual[Valor_Competencia] ),
			        FILTER(
			            ALL( Receita_Competencia_Manual ),
			            YEAR( Receita_Competencia_Manual[Data_Competencia] ) * 100
			                + MONTH( Receita_Competencia_Manual[Data_Competencia] ) = _AnoMes
			        )
			    )
			RETURN
			    IF( _Valor > 0, _Valor )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 82a38991-42f4-425d-80ae-c431ffe2e41c

	/// 1 se o mes em contexto tem receita por competencia lancada, 0 se nao. Usado pelo gerador para decidir o texto automatico.
	measure Competencia_Disponivel = IF( NOT ISBLANK( [Receita_Competencia] ), 1, 0 )
		formatString: 0
		displayFolder: Relatorio
		lineageTag: 87f1065a-29bb-4dd9-8b8a-9a7985555cd9

	/// Markup do mes = Receita por competencia / Custo operacional (definicao do Excel, Graficos!C28). Vazio sem competencia.
	measure Markup_Competencia = DIVIDE( [Receita_Competencia], ABS( [Custo_Operacional] ) )
		formatString: #,0.00"x";-#,0.00"x";0.00"x"
		displayFolder: Relatorio
		lineageTag: f7b04fc0-6d3b-4270-a062-352ce8e10fa4

	/// Media ponderada movel (soma competencia / soma custo) dos 6 meses que terminam no mes em contexto (Realiz.). So conta meses com competencia lancada. Equivale a Graficos!B28 do Excel.
	measure Markup_Competencia_6M =
			VAR _Fim = EOMONTH( MAX( ControleFinanceiro[Realiz.] ), 0 )
			VAR _Ini = EDATE( EOMONTH( _Fim, -1 ) + 1, -5 )
			VAR _Meses =
			    CALCULATETABLE(
			        VALUES( dCalendario[Ano_Mês_Num] ),
			        REMOVEFILTERS( dCalendario ),
			        dCalendario[Date] >= _Ini,
			        dCalendario[Date] <= _Fim
			    )
			VAR _Tab =
			    ADDCOLUMNS(
			        _Meses,
			        "@Comp",
			            VAR _m = dCalendario[Ano_Mês_Num]
			            RETURN
			                CALCULATE(
			                    SUM( Receita_Competencia_Manual[Valor_Competencia] ),
			                    FILTER(
			                        ALL( Receita_Competencia_Manual ),
			                        YEAR( Receita_Competencia_Manual[Data_Competencia] ) * 100
			                            + MONTH( Receita_Competencia_Manual[Data_Competencia] ) = _m
			                    )
			                ),
			        "@Custo",
			            VAR _m = dCalendario[Ano_Mês_Num]
			            RETURN
			                CALCULATE(
			                    ABS( [Custo_Operacional] ),
			                    REMOVEFILTERS( dCalendario ),
			                    dCalendario[Ano_Mês_Num] = _m
			                )
			    )
			VAR _Valida = FILTER( _Tab, [@Comp] > 0 )
			RETURN
			    DIVIDE( SUMX( _Valida, [@Comp] ), SUMX( _Valida, [@Custo] ) )
		formatString: #,0.00"x";-#,0.00"x";0.00"x"
		displayFolder: Relatorio
		lineageTag: 6fa32d14-ebd6-4572-a94b-c253ff2225c7

	/// Despesa_Pessoal do grupo Salários (Salários + Bonificações), via dGrupoPessoal.
	measure Pessoal_Salarios = CALCULATE( [Despesa_Pessoal], dGrupoPessoal[Grupo] = "Salários" )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 5c872c3e-99d9-4307-a98a-46aee840399c

	/// Despesa_Pessoal do grupo Encargos (Encargos + Provisões), via dGrupoPessoal.
	measure Pessoal_Encargos = CALCULATE( [Despesa_Pessoal], dGrupoPessoal[Grupo] = "Encargos" )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: df1baf8e-cc1c-4a3c-a4e3-4fc0d8fa7c30

	/// Residual: Despesa_Pessoal - Salários - Encargos. Garante que os 3 grupos sempre somam Despesa_Pessoal; inclui subcategoria não mapeada.
	measure Pessoal_Outros = [Despesa_Pessoal] - [Pessoal_Salarios] - [Pessoal_Encargos]
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: cf6e21d9-1ce0-40c7-9ce9-4dfae5ff7fdd

	/// Despesa_Pessoal em subcategorias sem linha em dGrupoPessoal. Diferente de zero vira alerta.
	measure Pessoal_Nao_Mapeado = [Despesa_Pessoal] - CALCULATE( [Despesa_Pessoal], dGrupoPessoal[Grupo] IN { "Salários", "Encargos", "Outros" } )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 83160974-af3f-4cc5-a0b6-97166d057841

	/// Total de Gasto do relatorio (positivo) = Tributo + Custo + Fixa + Variavel + Pessoal + Marketing + Despesa Financeira. Mesma definicao do v4 (total_gasto).
	measure Gasto_Total = -( [Tributo] + [Custo_Operacional] + [Despesa_Fixa] + [Despesa_Variavel] + [Despesa_Pessoal] + [Marketing_Comercial] + [Despesa_Financeira] )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: d14c1105-0263-4567-8c27-a0977392bb2a

	/// Conferencia: soma dos grupos de Pessoal menos Despesa_Pessoal. Deve ser 0.
	measure Chk_Pessoal = ROUND( [Pessoal_Salarios] + [Pessoal_Encargos] + [Pessoal_Outros] - [Despesa_Pessoal], 2 ) + ROUND( [Pessoal_Nao_Mapeado], 2 )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Chk
		lineageTag: 887b59f9-6ff8-4493-ab2b-daa1512bbe40

	/// Conferencia: valor de linhas sem Categoria ou com Categoria fora da lista conhecida (13 categorias). Deve ser 0.
	measure Chk_Sem_Categoria =
			CALCULATE(
			    SUM( ControleFinanceiro[Valor] ),
			    NOT( ControleFinanceiro[Categoria] IN {
			        "Operacional", "Custo.Operacional", "Tributo", "Despesa.Fixa", "Despesa.Variável",
			        "Despesa.com.Pessoal", "Marketing.Comercial", "Receita.Financeira", "Despesa.Financeira",
			        "Entrada", "Saída", "Investimento", "Retirada"
			    } )
			)
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Chk
		lineageTag: de459e9f-d836-4401-8548-6b16f00b67f6

	/// Conferencia: 1 se ha competencia lancada no mes, 0 se nao (alerta).
	measure Chk_Competencia = [Competencia_Disponivel]
		formatString: 0
		displayFolder: Chk
		lineageTag: 7268b0d5-76e6-421d-ac58-211b8bdbe7c8

	/// DFC: Categoria=Investimento que NAO e venda de ativo (Detalhamento diferente de 'Venda de Ativo Imobilizado'), em positivo. Mesma regra da coluna Saldo da planilha e da linha 5 do Valor_DFC. (Corrigido em 29/09/2026: antes usava o sinal do Valor, que erra quando a venda e lancada com Valor positivo.)
	measure Aquisicao_Ativos =
			CALCULATE(
			    SUM( ControleFinanceiro[Valor] ),
			    ControleFinanceiro[Categoria] = "Investimento",
			    ControleFinanceiro[Detalhamento/Categoria II] <> "Venda de Ativo Imobilizado"
			)
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 8cefbb08-ce06-4d39-8a5a-41e0b76359b1

	/// DFC: Categoria=Investimento com Detalhamento 'Venda de Ativo Imobilizado', em positivo. Mesma regra da coluna Saldo da planilha e da linha 6 do Valor_DFC. (Corrigido em 29/09/2026: antes usava o sinal do Valor.)
	measure Venda_Ativos =
			CALCULATE(
			    SUM( ControleFinanceiro[Valor] ),
			    ControleFinanceiro[Categoria] = "Investimento",
			    ControleFinanceiro[Detalhamento/Categoria II] = "Venda de Ativo Imobilizado"
			)
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 9854e713-b407-46ff-bb6a-673ffe012454

	/// Retirada do sócio no mês (Excel Gráficos!M26 = Aporte + Retirada do DFC), em positivo: Retirada - Aporte.
	measure Retirada_Socio = CALCULATE( SUM( ControleFinanceiro[Valor] ), ControleFinanceiro[Categoria] = "Retirada" ) - CALCULATE( SUM( ControleFinanceiro[Valor] ), ControleFinanceiro[Categoria] = "Aporte" )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: e17fe50b-b185-4ca9-9622-b177e13366de

	/// Retirada do sócio nos 12 meses que terminam no mês em contexto (Realiz.). Excel: Gráficos!B26 = SUM(C26:N26).
	measure Retirada_Socio_12M =
			VAR _Fim = EOMONTH( MAX( ControleFinanceiro[Realiz.] ), 0 )
			VAR _Ini = EDATE( EOMONTH( _Fim, -1 ) + 1, -11 )
			RETURN
			    CALCULATE(
			        [Retirada_Socio],
			        REMOVEFILTERS( dCalendario ),
			        dCalendario[Date] >= _Ini,
			        dCalendario[Date] <= _Fim
			    )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 1fb3e5b6-ef3e-4d49-b1c0-b566b5dd3807

	/// Media mensal = Retirada_Socio_12M / 12 (mesma regra do Excel e do v4; 'pro-labore medio' e so o nome, nao ha desconto).
	measure Retirada_Socio_Media_12M = DIVIDE( [Retirada_Socio_12M], 12 )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio
		lineageTag: 6a3dc17f-7dd2-4a2d-824b-becff073b6e9

	/// G01. Receita Operacional no mes do eixo dEixoMes, so nos 12 meses que terminam no mes da segmentacao.
	measure Eixo12M_Receita =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			VAR _Ref = YEAR( _RefData ) * 12 + MONTH( _RefData )
			VAR _I = SELECTEDVALUE( dEixoMes[Eixo_Indice] )
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			RETURN
			    IF( _I > _Ref - 12 && _I <= _Ref,
			        CALCULATE( [Receita_Operacional], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _M ) )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: Relatorio\Eixo12M
		lineageTag: 96b76ba2-b8e6-4d24-a615-a6cd8d08b702

	/// G01. Variacao da receita vs mes anterior no eixo de 12 meses. Vazio no primeiro mes com dados.
	measure Eixo12M_Receita_MoM =
			VAR _RefData = MAX( ControleFinanceiro[Realiz.] )
			VAR _Ref = YEAR( _RefData ) * 12 + MONTH( _RefData )
			VAR _I = SELECTEDVALUE( dEixoMes[Eixo_Indice] )
			VAR _M = SELECTEDVALUE( dEixoMes[Eixo_Ano_Mes_Num] )
			VAR _Atual = CALCULATE( [Receita_Operacional], REMOVEFILTERS( dCalendario ), dCalendario[Ano_Mês_Num] = _M )
			VAR _Ant =
			    CALCULATE(
			        [Receita_Operacional],
			        REMOVEFILTERS( dCalendario ),
			        FILTER( ALL( dCalendario[Ano], dCalendario[Mês_Num] ), dCalendario[Ano] * 12 + dCalendario[Mês_Num] = _I - 1 )
			    )
			RETURN
			    IF( _I > _Ref - 12 && _I <= _Ref && NOT ISBLANK( _Ant ), DIVIDE( _Atual - _Ant, _Ant ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Relatorio\Eixo12M
		lineageTag: 9013cbac-c9dd-4ac3-837a-1e64e86d9de7

	/// G01. Rotulo de texto: 'R$ 1,55M (+10,9%)'.
	measure Eixo12M_Rotulo_Receita =
			VAR _V = [Eixo12M_Receita]
			VAR _P = [Eixo12M_Receita_MoM]
			RETURN
			    IF( NOT ISBLANK( _V ),
			        "R$ " & FORMAT( _V / 1000000, "0.00", "pt-BR" ) & "M"
			            & IF( NOT ISBLANK( _P ), " (" & FORMAT( _P, "+0.0%;-0.0%;0.0%", "pt-BR" ) & ")" ) )
		displayFolder: Relatorio\Eixo12M
		lineageTag: d7e9b497-288f-4581-8848-b3805231f6bc

	/// G04. Markup_Competencia no eixo de 12 meses. Vazio em mes sem competencia (D5).
